{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"typegen": "wrangler types && react-router typegen",
		"deploy": "react-router build && WRANGLER_SEND_METRICS=false wrangler deploy",
		"deploy:version": "react-router build && wrangler versions upload",
		"deploy:promote": "wrangler versions deploy",
		"dev": "react-router dev",
		"postinstall": "wrangler types",
		"preview": "react-router build && vite preview",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"format": "biome format --write .",
		"auth:secret": "pnpm dlx @better-auth/cli@latest secret",
		"auth:generate": "pnpm dlx @better-auth/cli@latest generate --config=./app/services/auth/auth.server.ts --output=./app/services/db/schema/auth.ts",
		"db:generate": "drizzle-kit generate",
		"db:drop": "drizzle-kit drop",
		"db:seed:local": "tsx ./drizzle/seed/seed.ts",
		"db:seed:remote": "wrangler d1 execute DB --remote --file ./drizzle/seed/seed.sql",
		"db:reset:local": "tsx ./drizzle/seed/reset.ts",
		"db:delete:local": "rm -i ./.wrangler/state/v3/d1/miniflare-D1DatabaseObject/* || true",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@conform-to/react": "^1.20.2",
		"@conform-to/zod": "^1.20.2",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@origin-space/image-cropper": "^0.1.9",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-radio-group": "^1.4.7",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tooltip": "^1.2.16",
		"better-auth": "^1.6.26",
		"boring-avatars": "^2.0.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cookie": "^2.0.1",
		"drizzle-orm": "~0.45.2",
		"isbot": "^5.2.1",
		"lucide-react": "^1.30.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"shadcn": "^4.16.2",
		"sonner": "^2.0.7",
		"spin-delay": "^2.0.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@cloudflare/vite-plugin": "1.51.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@react-router/dev": "^8.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "^0.31.10",
		"drizzle-seed": "^0.3.1",
		"lefthook": "^2.1.10",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.11",
		"typescript": "^7.0.2",
		"vite": "8.2.1",
		"vite-plugin-devtools-json": "^1.1.0",
		"wrangler": "4.120.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lefthook",
			"sharp",
			"workerd"
		]
	}
}
